# ================================================================
# PocketSmart AI Environment Configuration
# ================================================================

# Gemini AI Configuration
# Set your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
# Configurable model (e.g., gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Application Security
SECRET_KEY=pocketsmart_super_secret_session_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./pocketsmart.db

# Travel & Distance Cost Configuration (Estimates in INR per KM)
CAR_COST_PER_KM=12.0
BIKE_COST_PER_KM=4.5
PUBLIC_TRANSPORT_ESTIMATE=2.0

# Optional Google APIs (App degrades gracefully using OpenStreetMap/Haversine if not set)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=

# App Settings
APP_NAME="PocketSmart AI"
APP_ENV=development
DEBUG=True
DEMO_MODE=true
